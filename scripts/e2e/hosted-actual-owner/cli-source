#!/bin/bash
set -euo pipefail

# The admitted supervisor owns FD11. Never reopen it or pass v2 through the
# legacy launcher checks (which allocate helpers and overwrite native FD9).
if [[ "${1-}" == --hosted-actual-owner-sealed-protocol=* ]]; then
  if [[ "${1-}" != "--hosted-actual-owner-sealed-protocol=v2" || "$#" -ne 3 || "${2-}" != "--runtime-manifest" || "${3-}" != "/sandbox/runtime-manifest.json" ]]; then
    exit 64
  fi
  exec /proc/self/fd/11 run ./scripts/e2e/hosted-actual-owner-owner.ts "$@"
fi

REPOSITORY_ROOT="$(pwd -P)"
SCRIPT_DIR="$REPOSITORY_ROOT/scripts/e2e/hosted-actual-owner"
STABLE_LAUNCHER="$SCRIPT_DIR/cli-source"

if [[ ! -f "$STABLE_LAUNCHER" ]] || ! /usr/bin/cmp -s -- "$0" "$STABLE_LAUNCHER"; then
  echo "The acceptance launcher is not the exact source anchored by the repository cwd." >&2
  exit 63
fi

if [[ "${1-}" == "hosted-actual-owner-e2e" ]]; then
  shift
fi

if [[ "${1-}" != "--hosted-actual-owner-acceptance-entry" || "${3-}" != "--runtime-manifest" ||
  "${5-}" != "--actual-owner-contract" || "${7-}" != "--actual-owner-contract-sha256" ||
  "${9-}" != "--actual-owner-contract-byte-count" || "${11-}" != "--launcher-lease-fd" ||
  "${13-}" != "--liveness-fd" || "${15-}" != "--bootstrap-fd" || "$#" -ne 16 ]]; then
  echo "This source-only launcher accepts only the hosted actual-owner acceptance entry." >&2
  exit 64
fi

ENTRY_ANCHOR="$2"
ENTRY_SOURCE="$REPOSITORY_ROOT/scripts/e2e/hosted-actual-owner-owner.ts"
if [[ "$ENTRY_ANCHOR" != /* ]] || [[ ! -f "$ENTRY_ANCHOR" ]] ||
  ! /usr/bin/cmp -s -- "$ENTRY_ANCHOR" "$ENTRY_SOURCE"; then
  echo "Refusing an acceptance entry that is not the exact repository source." >&2
  exit 65
fi

# The product harness passes an immutable staged Git-blob anchor.  It proves the
# cross-repository byte contract, but executing that isolated TypeScript file
# would sever owner.ts from its relative source imports.  Execute the matching
# repository-local source entry only after the byte comparison above.
ENTRY_MODE="$(/usr/bin/stat -c '%a:%h:%u' -- "$ENTRY_ANCHOR")"
if [[ "$ENTRY_MODE" != "400:1:$(/usr/bin/id -u)" ]]; then
  echo "Refusing an unsafe hosted actual-owner acceptance entry anchor." >&2
  exit 67
fi

if [[ "${NODE_ENV:-}" == "production" ]]; then
  echo "The hosted actual-owner acceptance launcher is unavailable in production." >&2
  exit 66
fi

BUN_BIN="${HOSTED_ACTUAL_OWNER_E2E_BUN_EXECUTABLE-}"
BUN_SHA256="${HOSTED_ACTUAL_OWNER_E2E_BUN_SHA256-}"
if [[ "$BUN_BIN" != /* ]] || [[ ! "$BUN_SHA256" =~ ^[0-9a-f]{64}$ ]] ||
  [[ ! -f "$BUN_BIN" ]] || [[ ! -x "$BUN_BIN" ]]; then
  echo "A product-supplied absolute Bun executable and digest are required." >&2
  exit 68
fi
exec 9<"$BUN_BIN"
BUN_MODE="$(/usr/bin/stat -Lc '%F:%h:%u:%a:%d:%i:%s:%y:%z' -- /proc/self/fd/9)"
BUN_PATH_MODE="$(/usr/bin/stat -Lc '%F:%h:%u:%a:%d:%i:%s:%y:%z' -- "$BUN_BIN")"
BUN_DIGEST="$(/usr/bin/sha256sum /proc/self/fd/9)"
BUN_AFTER="$(/usr/bin/stat -Lc '%F:%h:%u:%a:%d:%i:%s:%y:%z' -- /proc/self/fd/9)"
BUN_PATH_AFTER="$(/usr/bin/stat -Lc '%F:%h:%u:%a:%d:%i:%s:%y:%z' -- "$BUN_BIN")"
if [[ "$BUN_MODE" != "$BUN_PATH_MODE" ]] || [[ "$BUN_MODE" != "$BUN_AFTER" ]] ||
  [[ "$BUN_MODE" != "$BUN_PATH_AFTER" ]] || [[ "$BUN_MODE" != "regular file:1:$(/usr/bin/id -u):500:"* ]] ||
  [[ "$BUN_DIGEST" != "$BUN_SHA256  /proc/self/fd/9" ]]; then
  echo "The product-supplied Bun executable identity is unsafe or rotated." >&2
  exit 69
fi

cd "$REPOSITORY_ROOT"
exec /proc/self/fd/9 run "$ENTRY_SOURCE" --runtime-manifest "$4" \
  --actual-owner-contract "$6" --actual-owner-contract-sha256 "$8" \
  --actual-owner-contract-byte-count "${10}" --launcher-lease-fd "${12}" \
  --liveness-fd "${14}" --bootstrap-fd "${16}"
