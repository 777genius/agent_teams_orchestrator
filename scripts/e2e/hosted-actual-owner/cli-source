#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
REPOSITORY_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)"

if [[ "${1-}" == "hosted-actual-owner-e2e" ]]; then
  shift
fi

if [[ "${1-}" != "--hosted-actual-owner-acceptance-entry" || "${3-}" != "--runtime-manifest" || "$#" -ne 4 ]]; then
  echo "This source-only launcher accepts only the hosted actual-owner acceptance entry." >&2
  exit 64
fi

ENTRY="$2"
EXPECTED_ENTRY="$SCRIPT_DIR/owner.ts"
if [[ "$ENTRY" != "$EXPECTED_ENTRY" ]]; then
  echo "Refusing an unpinned hosted actual-owner acceptance entry." >&2
  exit 65
fi

if [[ "${NODE_ENV:-}" == "production" ]]; then
  echo "The hosted actual-owner acceptance launcher is unavailable in production." >&2
  exit 66
fi

BUN_BIN="${BUN_INSTALL:-$HOME/.bun}/bin/bun"
if [[ ! -x "$BUN_BIN" ]]; then
  BUN_BIN="$(command -v bun)"
fi

cd "$REPOSITORY_ROOT"
exec "$BUN_BIN" run "$ENTRY" --runtime-manifest "$4"
