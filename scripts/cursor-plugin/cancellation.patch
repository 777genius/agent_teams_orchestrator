+import { dirname, isAbsolute, join } from "node:path";
+import { resolveOpenCodeConfigPath } from "../plugin-toggle.js";
+
+/** Managed app transport, resolved in the OpenCode host before native env isolation. */
+export function managedMcpDispatchInstructions(env: NodeJS.ProcessEnv = process.env): string {
+  if (!env.AGENT_TEAMS_CURSOR_PROXY_PORT) return "";
+  const executable = env.CURSOR_AGENT_EXECUTABLE;
+  if (!executable || !isAbsolute(executable) || !env.XDG_CONFIG_HOME) {
+    throw new Error("Managed Cursor MCP dispatch requires the scoped CLI bridge and config home");
+  }
+  const quote = (value: string) => "'" + value.replace(/'/g, "'\"'\"'") + "'";
+  const command = `OPENCODE_CONFIG=${quote(resolveOpenCodeConfigPath(env))} ${quote(join(dirname(executable), "mcptool"))}`;
+  return `SYSTEM: Managed Cursor app MCP dispatch
+The listed OpenCode tool schemas are descriptions, not additional native Cursor tools. For app MCP calls use the approved managed mcptool transport through your native shell tool (intercepted by OpenCode bash). Do not emit an OpenAI tool_call in text or try nonexistent native agent-teams_* / mcp__agent-teams__* tools.
+This is the managed transport for the MCP server named agent-teams, including when instructions refer to GetMcpTools / CallMcpTool or listed agent-teams_* names. It is not permission to call raw HTTP, discover endpoints, create helper scripts, or change configuration. Keep all action-mode and message-envelope constraints.
+Discover available tool names with: ${command} tools agent-teams
+Call with: ${command} call agent-teams '<tool-name>' '<JSON-arguments>'
+Use the exact discovered tool name (for listed agent-teams_message_send or mcp__agent-teams__message_send, the server is agent-teams and tool is message_send). Preserve the listed schema and required message envelope. Shell-quote JSON as one argument; escape an apostrophe inside single quotes as '\"'\"'. Use the absolute command and scoped OPENCODE_CONFIG above on every call; do not depend on native wrapper PATH or inherit its environment in OpenCode bash.
+Wait for the shell result before proceeding. If the server/tool is absent or a call fails, report the failure; do not switch to raw HTTP or blindly retry a side effect. Text claiming a tool call is not execution.`;
+}
